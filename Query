class Messenger(object):
    def __init__(
            self,
            model_sender: mission_create_n_modify_model.MsnCreateModifyModel,
            model_receiver: mission_navigator_model.MissionMgrModel
        ) -> None:
        super().__init__()

        self.model_sender = model_sender # 임무 전송자 모델
        self.model_receiver = model_receiver # 임무 수신자 모델

        self.model_sender.missionPlanEngaged.connect(self._send_mission)

    def _send_mission(self, msn: dict) -> None:
        msn_cat = self.model_sender.current_page[12:]
        msn_list = self.model_receiver.json_missions.get(msn_cat)

        if msn.get('name') == '' or msn.get('driving_mode') == '':
            print('기본 정보를 입력하세요')
        else:
            is_updated = False
            for index, item in enumerate(msn_list):
                if item.get('name') == msn.get('name'):
                    msn_list[index]['details'] = msn['details']
                    is_updated = True
                    break

            if not is_updated:
                msn_list.append(msn)

            self.model_receiver.json_missions.update({msn_cat: msn_list})
            self.model_receiver.save_to_json()

model_receiver.save_to_json()에 시그널을 방출하는 코드가 있어. 그런데 그 시그널이 동작을 안해. 이유가 뭘까? 참고로 save_to_json() 내 다른 코드는 잘 작동해.
